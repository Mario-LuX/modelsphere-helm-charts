{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sglang chart values",
  "description": "Helm silently ignores a values key it does not recognise, so a misspelling in a 300-line override file is not an error -- it is a setting that quietly does not apply. This schema exists to turn that class of failure into a failed render. The case it was written for: `failurThreshold` instead of `failureThreshold` under startupProbe. The chart passes probe blocks through with toYaml, the API server prunes the unknown field rather than rejecting it, the probe falls back to the Kubernetes default failureThreshold of 3, and a model with a 40-minute cold load gets killed after 45 seconds -- with no error anywhere. `additionalProperties: false` is therefore the point of this file, not decoration. Blocks the chart merely forwards to Kubernetes (resources, affinity, tolerations, env, volumes, securityContext) are deliberately left open: the API server owns those contracts, and restating them here would be a second source of truth that goes stale. The vendored cart subchart likewise owns its own values.",
  "type": "object",
  "additionalProperties": false,

  "definitions": {
    "httpGet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "port": { "type": ["string", "integer"] },
        "host": { "type": "string" },
        "scheme": { "type": "string", "enum": ["HTTP", "HTTPS"] },
        "httpHeaders": { "type": "array" }
      }
    },
    "probe": {
      "description": "A Kubernetes Probe, forwarded verbatim. Strict on purpose -- an unknown key here is the failure this whole file exists to catch.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "httpGet": { "$ref": "#/definitions/httpGet" },
        "exec": { "type": "object" },
        "tcpSocket": { "type": "object" },
        "grpc": { "type": "object" },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "successThreshold": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "intOrPercent": {
      "description": "An IntOrString: a bare count, a \"25%\" string, or \"\" to mean unset.",
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "string", "pattern": "^([0-9]+%?)?$" }
      ]
    }
  },

  "properties": {
    "global": {
      "description": "Helm's reserved key for values shared with subcharts. Left open.",
      "type": "object"
    },

    "fullnameOverride": { "type": "string" },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "healthEndpointGeneration": { "type": "boolean" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "progressDeadlineSeconds": { "type": "integer", "minimum": 1 },
    "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
    "schedulerName": { "type": "string" },
    "priorityClassName": { "type": "string" },

    "lws": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "integer", "minimum": 1 },
        "replicas": { "type": "integer", "minimum": 0 },
        "distPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "startupPolicy": { "type": "string", "enum": ["LeaderCreated", "LeaderReady"] },
        "restartPolicy": { "type": "string", "enum": ["Default", "RecreateGroupOnPodRestart"] },
        "subdomainPolicy": { "type": "string", "enum": ["Shared", "UniquePerReplica"] },
        "waitForLeader": { "type": "boolean" },
        "workerTerminationGracePeriodSeconds": {
          "description": "Empty means \"same as the leader's\".",
          "type": ["integer", "string", "null"]
        },
        "leaderPreStopKill": { "type": "boolean" },
        "rolloutStrategy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["RollingUpdate"] },
            "rollingUpdateConfiguration": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "maxSurge": { "$ref": "#/definitions/intOrPercent" },
                "maxUnavailable": { "$ref": "#/definitions/intOrPercent" }
              }
            }
          }
        }
      }
    },

    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 }
      }
    },

    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "localPath": { "type": "string", "minLength": 1 },
        "mountPath": { "type": "string", "minLength": 1 },
        "hostPathType": { "type": "string" },
        "contextLength": {
          "description": "Quoted in values.yaml, and empty means \"let SGLang use the model's own\". An integer is accepted too.",
          "type": ["string", "integer"]
        },
        "gpus": {
          "description": "Quoted in values.yaml. PER POD, not per LWS group.",
          "type": ["string", "integer"]
        }
      }
    },

    "modelCheck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "requiredGlobs": { "type": "array", "items": { "type": "string" } }
      }
    },

    "extraArgs": {
      "description": "Appended verbatim to the engine command line. Entries are toString'd, so `- 8` and `- \"8\"` both work.",
      "type": "array",
      "items": { "type": ["string", "integer", "number", "boolean"] }
    },

    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },

    "startupProbe": { "$ref": "#/definitions/probe" },
    "readinessProbe": { "$ref": "#/definitions/probe" },
    "livenessProbe": { "$ref": "#/definitions/probe" },

    "hangWatcher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" }
          }
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pollIntervalSec": { "type": "integer", "minimum": 1 },
            "stallSec": { "type": "integer", "minimum": 1 },
            "metricsTimeoutSec": { "type": "integer", "minimum": 1 },
            "activeProbeEnabled": { "type": "boolean" },
            "activeProbePath": { "type": "string" },
            "activeProbeMethod": { "type": "string" },
            "activeProbeBody": { "type": "string" },
            "activeProbeTimeoutSec": { "type": "integer", "minimum": 1 }
          }
        },
        "livenessProbe": { "$ref": "#/definitions/probe" },
        "resources": { "type": "object" }
      }
    },

    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preStop": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "endpointSyncSeconds": { "type": "integer", "minimum": 0 },
            "drainSeconds": { "type": "integer", "minimum": 0 },
            "pollIntervalSeconds": { "type": "integer", "minimum": 1 }
          }
        },
        "shutdownReserveSeconds": { "type": "integer", "minimum": 0 },
        "forceShutdown": { "type": "boolean" }
      }
    },

    "scaler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 0 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "syncPeriodSeconds": { "type": "integer", "minimum": 1 },
        "metricProvider": { "type": "string", "enum": ["Prometheus", "Custom"] },
        "serverAddress": { "type": "string" },
        "serverHeaders": { "type": "object" },
        "customProvider": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "serviceId": { "type": "string" },
            "path": { "type": "string" },
            "namespace": { "type": "string" }
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "query": { "type": "string" },
              "target": { "type": ["string", "integer", "number"] }
            }
          }
        },
        "scaleDown": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "behavior": { "type": "string" },
            "stabilizationWindowSeconds": { "type": "integer", "minimum": 0 },
            "maxStepReplicas": { "type": "integer", "minimum": 0 },
            "deletionCostQuery": { "type": "string" }
          }
        }
      }
    },

    "sloRequirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "extraSpec": {
          "description": "Free-form LLMSLORequirement spec fields, merged alongside serviceId. Open by design -- that schema belongs to the inference operator, not to this chart. serviceId is not among them: it comes from scaler.customProvider.serviceId, and a copy here is rejected at render time.",
          "type": "object"
        }
      }
    },

    "metricsMock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string" },
        "value": { "type": ["string", "integer"] }
      }
    },

    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string" },
        "interval": { "type": "string" },
        "scrapeTimeout": { "type": "string" },
        "labels": { "type": "object" },
        "podTargetLabels": { "type": "array", "items": { "type": "string" } }
      }
    },

    "cart": {
      "description": "The vendored CART subchart owns its own values; only the condition key is asserted here. Add charts/sglang/charts/cart/values.schema.json if that side needs the same protection.",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },

    "modelRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "includeNotReady": { "type": "boolean" }
          }
        },
        "nginx": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "route": {
              "description": "A URL path, so it takes the DOTTED spelling (fallback-modelforge-0.1), not the namespace spelling.",
              "type": "string"
            },
            "outputConfigMap": { "type": "string" },
            "service": { "type": "string" },
            "selector": { "type": "string" },
            "values": {
              "description": "Free-form openresty route settings, keyed per route. Open by design -- the key set belongs to openresty's autoconfig, not to this chart. Values reach it as strings.",
              "type": "object",
              "additionalProperties": { "type": ["string", "integer", "number", "boolean"] }
            },
            "peers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "use": { "type": "string" },
                  "priority": { "type": "integer" },
                  "maxConcurrency": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        },
        "cart": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxLoad": { "type": "integer", "minimum": 1 }
          }
        },
        "monitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "outputConfigMap": { "type": "string" },
            "model": {
              "description": "Monitor's ConfigMap is keyed per MODEL, not per route -- two releases sharing this value clobber each other's row.",
              "type": "string"
            },
            "gpuType": { "type": "string" },
            "nginx": { "type": ["object", "null"] },
            "router": { "type": ["object", "null"] }
          }
        }
      }
    },

    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": { "type": "object" },
        "maxUnavailable": { "$ref": "#/definitions/intOrPercent" },
        "minAvailable": { "$ref": "#/definitions/intOrPercent" },
        "unhealthyPodEvictionPolicy": {
          "type": "string",
          "enum": ["", "AlwaysAllow", "IfHealthyBudget"]
        }
      }
    },

    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["RollingUpdate", "Recreate"] },
        "rollingUpdate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxSurge": { "$ref": "#/definitions/intOrPercent" },
            "maxUnavailable": { "$ref": "#/definitions/intOrPercent" }
          }
        }
      }
    },

    "env": { "type": "array" },
    "volumes": { "type": "array" },
    "volumeMounts": { "type": "array" },
    "tolerations": { "type": "array" },
    "resources": { "type": "object" },
    "securityContext": { "type": "object" },
    "podLabels": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "affinity": { "type": "object" }
  }
}
